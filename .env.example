# Local development. Production must set APP_ENV=production and use PostgreSQL.
APP_ENV=development
# Generate a unique random value; keep it stable across restarts. Required in production.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Local SQLite database file. Production requires a private PostgreSQL URL.
DATABASE_URL=sqlite:///./janadhish.db
# Set this to the actual browser origin when using a separate frontend server.
FRONTEND_ORIGIN=http://127.0.0.1:8000
# Required in production for canonical product links and the sitemap.
PUBLIC_SITE_URL=http://127.0.0.1:8000
# Optional. Leave blank for the built-in catalog assistant.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
